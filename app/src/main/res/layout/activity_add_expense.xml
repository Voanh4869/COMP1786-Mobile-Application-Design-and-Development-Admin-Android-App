<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="60dp">

        <EditText
            android:id="@+id/etExpDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date of Expense (Required)"
            android:focusable="false"
            android:inputType="none"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etExpAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount (Required)"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etExpCurrency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Currency (Required, e.g. USD, EUR)"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type of Expense"
            android:layout_marginTop="16dp"/>
        <Spinner
            android:id="@+id/spExpType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Method"
            android:layout_marginTop="16dp"/>
        <Spinner
            android:id="@+id/spExpPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <EditText
            android:id="@+id/etExpClaimant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Claimant (Required)"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Status"
            android:layout_marginTop="16dp"/>
        <Spinner
            android:id="@+id/spExpPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <EditText
            android:id="@+id/etExpDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description (Optional)"
            android:inputType="textMultiLine"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etExpLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Location (Optional)"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnSaveExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Expense"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>